#!/usr/bin/env python3
import json
import os

with open(os.environ["NAGIOS_MOLECULE_TRACE"], "a") as trace:
    trace.write(json.dumps({
        "command": "psql",
        "host": os.environ["PGHOST"],
        "port": os.environ["PGPORT"],
        "user": os.environ["PGUSER"],
    }) + "\n")
print("postgres\napp")
